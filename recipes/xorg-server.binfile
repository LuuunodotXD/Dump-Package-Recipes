name=xorg-server
version=21.1.16
description=X.Org X server (rootless via setuid wrapper, udev, GLX + glamor + DRI2/3)
url=https://raw.githubusercontent.com/LuuunodotXD/Dump-Packages/main/main/xorg-server-21.1.16.tar.gz
compression=gzip
md5=c005c3b578d1d1efff927d9201417638
sha256=0beb85fc0d37d318ded0891aac85908c8e8996de104cb9b27adbb5c368f31169
deps=pixman libpciaccess libdrm libxfont2 libxkbfile libxau libxdmcp libxcvt nettle eudev xkbcomp xkeyboard-config font-misc-misc mesa libepoxy libxshmfence
postinstall=chmod 4755 /usr/libexec/Xorg.wrap
conffiles=/etc/X11/Xwrapper.config
