name=br-wifi
version=1.9
description=Text-mode Wi-Fi manager for BaseRoot (several saved networks, priorities, background service)
url=https://raw.githubusercontent.com/LuuunodotXD/Dump-Packages/main/main/br-wifi-1.9.tar.gz
compression=gzip
md5=67a12c9c8da586526421df21d05f5469
sha256=a725e5d6fc3de2270700e0dbe9215ec9b464bbfd735494804841afdec61e6785
deps=iw wpa_supplicant libnl
postinstall=echo "br-wifi is installed, but the Wi-Fi service is OFF at boot and you have to turn it on by hand. Edit /etc/br-wifi.conf and change ENABLE from no to yes (it runs from /etc/init.d/S32-wifi). To start it right now: br-wifi start. To just pick a network without the service: br-wifi"
conffiles=/etc/br-wifi.conf
