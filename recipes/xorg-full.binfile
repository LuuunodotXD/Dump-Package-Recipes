name=xorg-full
version=1.0
description=Complete X11: xorg plus every X library, GTK2, GTK3, SVG and feh
url=https://raw.githubusercontent.com/LuuunodotXD/Dump-Packages/main/main/xorg-full-1.0.tar.gz
compression=gzip
md5=d1250f6074708c0d2c889d2ac4a0428e
sha256=5c1036f542d5024456d5b0ae8229ca621dfb28cc08c2532450e91a66e2968824
deps=xorg libxcomposite libxcursor libxdamage libxfixes libxi libxinerama libxkbcommon libxpresent libxres libxscrnsaver libxtst libxv libxvmc libxxf86dga libxxf86vm libxfont libxaw libxmu libxpm libxt libsm libice xcb-util xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm gtk2 gtk3 librsvg glu imlib2 feh hicolor-icon-theme shared-mime-info dbus xorg-virtio-cursor
postinstall=echo "xorg-full is ready. For GTK3 programs start your session with: dbus-run-session -- <your window manager>."
conffiles=
